# Машинно-специфичное — путь к ai-memory, локальные оверрайды.
# Файл сам себя помечает «НЕ коммитить как шаблон».
.claude/settings.local.json

# Служебные маркеры кадэнса гейтов (состояние машины, не шаблон).
.claude/.security-gate-seen
.claude/.*-seen

# Python-мусор от evals/scripts.
__pycache__/
*.pyc

# Локальные оверрайды команд гейтов, если заводятся под конкретную машину.
.claude/*.local.txt

# --- Node / Vite -------------------------------------------------------------
node_modules/
dist/
dist-ssr/
coverage/
*.local
.vite/

# Логи пакетного менеджера.
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# macOS
.DS_Store

# --- impeccable ---------------------------------------------------------------
# Скиллы качаются отдельно от npm-пакета (`npx impeccable skills install`) и
# весят 3.4 МБ вендорных скриптов. В git не кладём по той же причине, по какой
# не кладём node_modules: это восстановимый артефакт, а репозиторий публичный и
# идёт в заявку. Версия инструмента закреплена в package.json.
# Восстановить: npx impeccable skills install -y --providers=claude --scope=project --no-hooks
.claude/skills/impeccable/

# --- Рабочая обвязка и процессные документы ----------------------------------
# Сняты с учёта 16.08.2026 по решению Антона: в публичном репозитории должен
# лежать продукт, а не то, чем его делали. На диске всё остаётся — протокол
# сессий, хуки и гейты продолжают работать локально.
#
# ВНИМАНИЕ: снятие с учёта не убирает файлы из ИСТОРИИ. В коммитах до 16.08
# они по-прежнему видны. Чтобы их не стало совсем, нужна перезапись истории и
# force-push, а это обесценивает даты коммитов как доказательство сроков
# работы (`#F-15`). Решение сознательное.
.claude/
playbook/
AGENTS.md
CLAUDE.md
CHAT_HANDOFF.md
NAVIGATION.md
GOAL_GUIDE.md
GOAL.md
PLAN.md
CORE_PRINCIPLES.md
DECISIONS.md
FACTS.md
CHECKPOINT_CURRENT.md
SUBMISSION.md
