# Машинно-специфичное — путь к ai-memory, локальные оверрайды.
# Файл сам себя помечает «НЕ коммитить как шаблон».
.claude/settings.local.json

# Служебные маркеры кадэнса гейтов (состояние машины, не шаблон).
.claude/.security-gate-seen
.claude/.*-seen

# Python-мусор от evals/scripts.
__pycache__/
*.pyc

# Локальные оверрайды команд гейтов, если заводятся под конкретную машину.
.claude/*.local.txt

# --- Node / Vite -------------------------------------------------------------
node_modules/
dist/
dist-ssr/
coverage/
*.local
.vite/

# Логи пакетного менеджера.
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# macOS
.DS_Store

# --- impeccable ---------------------------------------------------------------
# Скиллы качаются отдельно от npm-пакета (`npx impeccable skills install`) и
# весят 3.4 МБ вендорных скриптов. В git не кладём по той же причине, по какой
# не кладём node_modules: это восстановимый артефакт, а репозиторий публичный и
# идёт в заявку. Версия инструмента закреплена в package.json.
# Восстановить: npx impeccable skills install -y --providers=claude --scope=project --no-hooks
.claude/skills/impeccable/
